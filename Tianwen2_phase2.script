%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable t251030 t260607 t270424 bt t271129 t3501 t2901;
GMAT t251030 = 30978.50042863868;
GMAT t260607 = 31199.50042863868;
GMAT t270424 = 31520.50042863868;
GMAT bt = 1000;
GMAT t271129 = 31736.50042863868;
GMAT t3501 = 34329.50042863868;
GMAT t2901 = 32165.50042863868;






%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
GMAT tw2phase3.ChemicalTank1.FuelMass = 180;
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(tw2phase3.RA = 57.58771860995077, {Perturbation = 0.0001, Lower = 10, Upper = 360, MaxStep = 10, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(tw2phase3.DEC = 12.11800507346963, {Perturbation = 0.0001, Lower = -90, Upper = 90, MaxStep = 10, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   BeginFiniteBurn DefaultFB(tw2phase3);
   Propagate Sol(tw2phase3) {tw2phase3.ElapsedDays = 2600};
   EndFiniteBurn DefaultFB(tw2phase3);
   Achieve DefaultDC(tw2phase3.panXyz.BdotR = 42165.0, {Tolerance = 100});
   Achieve DefaultDC(tw2phase3.panXyz.BdotT = 42165.0, {Tolerance = 100});
EndTarget;  % For targeter DefaultDC
