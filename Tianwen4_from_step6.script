Create OrbitView OrbitView3;
GMAT OrbitView3.SolverIterations = Current;
GMAT OrbitView3.UpperLeft = [ 0.7135036496350365 0.5289608177172062 ];
GMAT OrbitView3.Size = [ 0.2655109489051095 0.4633730834752982 ];
GMAT OrbitView3.RelativeZOrder = 218;
GMAT OrbitView3.Maximized = false;
GMAT OrbitView3.Add = {DefaultSC, Jupiter};
GMAT OrbitView3.CoordinateSystem = Juxyz;
GMAT OrbitView3.DrawObject = [ true true ];
