%----------------------------------------
%---------- Mission Sequence
%----------------------------------------


BeginMissionSequence;
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(burn1.Element1 = 0.07706454017276526, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn1.Element2 = -0.04778187210555846, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn1.Element3 = 0.04688118169954663, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver burn1(DefaultSC);
   Propagate solprop(DefaultSC) {DefaultSC.TDBModJulian = 32602.65059487268};
   Propagate venusprop(DefaultSC) {DefaultSC.Venus.Periapsis};
   Achieve DefaultDC(DefaultSC.venusxyz.BdotR = 5088.846, {Tolerance = 0.1});
   Achieve DefaultDC(DefaultSC.venusxyz.BdotT = 23767.763, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Propagate venusprop(DefaultSC) {DefaultSC.TDBModJulian = 32605.84531773148};
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(burn2.Element1 = 0.002988558853508463, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn2.Element2 = -0.02818215733425445, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn2.Element3 = 0.004210772870614591, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver burn2(DefaultSC);
   Propagate solprop(DefaultSC) {DefaultSC.TDBModJulian = 32916.58461369213};
   Propagate earthprop(DefaultSC) {DefaultSC.Earth.Periapsis};
   Achieve DefaultDC(DefaultSC.earthxyz.BdotR = -5410.741, {Tolerance = 0.1});
   Achieve DefaultDC(DefaultSC.earthxyz.BdotT = -14515.139, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Propagate earthprop(DefaultSC) {DefaultSC.ElapsedDays = 2};
Propagate solprop(DefaultSC) {DefaultSC.Sun.Apoapsis};
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(burn3.Element1 = -0.1524363921917581, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn3.Element3 = 0.4263762823140304, {Perturbation = 0.0001, Lower = -3, Upper = 3, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(burn3.Element2 = 0.03808469135004337, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver burn3(DefaultSC);
   Propagate solprop(DefaultSC) {DefaultSC.TDBModJulian = 33745.46683991898};
   Propagate earthprop(DefaultSC) {DefaultSC.Earth.Periapsis};
   Achieve DefaultDC(DefaultSC.earthxyz.BdotR = -3174.805517, {Tolerance = 0.1});
   Achieve DefaultDC(DefaultSC.earthxyz.BdotT = 12486.774499, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Propagate earthprop(DefaultSC) {DefaultSC.ElapsedDays = 2};
Propagate solprop(DefaultSC) {DefaultSC.TDBModJulian = 34655.58333333334};
