GMAT SolView.EclipticPlane = Off;
GMAT SolView.XYPlane = On;
GMAT SolView.WireFrame = Off;
GMAT SolView.Axes = On;
GMAT SolView.Grid = Off;
GMAT SolView.SunLine = Off;
GMAT SolView.UseInitialView = On;
GMAT SolView.StarCount = 7000;
GMAT SolView.EnableStars = Off;
GMAT SolView.EnableConstellations = Off;

Create GroundTrackPlot GroundTrackPlot1;
GMAT GroundTrackPlot1.SolverIterations = Current;
GMAT GroundTrackPlot1.UpperLeft = [ 0.02470588235294117 0.5356265356265356 ];
GMAT GroundTrackPlot1.Size = [ 0.3541176470588235 0.3992628992628993 ];
GMAT GroundTrackPlot1.RelativeZOrder = 141;
GMAT GroundTrackPlot1.Maximized = false;
GMAT GroundTrackPlot1.Add = {Tianwen2};
GMAT GroundTrackPlot1.DataCollectFrequency = 1;
GMAT GroundTrackPlot1.UpdatePlotFrequency = 50;
GMAT GroundTrackPlot1.NumPointsToRedraw = 0;
GMAT GroundTrackPlot1.ShowPlot = true;
GMAT GroundTrackPlot1.MaxPlotPoints = 20000;
GMAT GroundTrackPlot1.CentralBody = Earth;
GMAT GroundTrackPlot1.TextureMap = 'ModifiedBlueMarble.jpg';

%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable epoch1 epoch2 epoch3 x1 y1 z1;
GMAT epoch1 = 0;
GMAT epoch2 = 30979.2083912037;
GMAT epoch3 = 31199.2083912037;
GMAT x1 = 59131352;
GMAT y1 = 126807594;
GMAT z1 = -218039;





%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(Burn1.Element1 = 3.500872959040924, {Perturbation = 0.0001, Lower = -10e300, Upper = 10e300, MaxStep = 0.02, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(Burn1.Element2 = -0.6049744212531266, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.02, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(Burn1.Element3 = -0.007773983194035092, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.02, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver Burn1(Tianwen2);
   Propagate NearEarth(Tianwen2) {Tianwen2.ElapsedSecs = 12000.0};
   Propagate Sol(Tianwen2) {Tianwen2.TAIModJulian = epoch2};
   Achieve DefaultDC(Tianwen2.SolXyz.X = x1, {Tolerance = 0.1});
   Achieve DefaultDC(Tianwen2.SolXyz.Y = y1, {Tolerance = 0.1});
   Achieve DefaultDC(Tianwen2.SolXyz.Z = z1, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Target DefaultDC {SolveMode = RunInitialGuess, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary DefaultDC(Burn2.Element1 = -1.830991044256798, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(Burn2.Element2 = -0.1548044494460739, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary DefaultDC(Burn2.Element3 = 1.198654440241522, {Perturbation = 0.0001, Lower = -10, Upper = 10, MaxStep = 0.01, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver Burn2(Tianwen2);
   Propagate Sol(Tianwen2) {Tianwen2.TAIModJulian = epoch3};
   Achieve DefaultDC(Tianwen2.kaXyz.BdotR = 65.0, {Tolerance = 0.1});
   Achieve DefaultDC(Tianwen2.kaXyz.BdotT = 65.0, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
