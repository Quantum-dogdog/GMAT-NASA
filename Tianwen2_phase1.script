%----------------------------------------
%---------- Hardware Components
%----------------------------------------

Create ChemicalTank Tank1;
GMAT Tank1.AllowNegativeFuelMass = true;
GMAT Tank1.FuelMass = 1000;
GMAT Tank1.Pressure = 1500;
GMAT Tank1.Temperature = 20;
GMAT Tank1.RefTemperature = 20;
GMAT Tank1.Volume = 5;
GMAT Tank1.FuelDensity = 780;
GMAT Tank1.PressureModel = PressureRegulated;

Create ChemicalThruster Thruster1;
GMAT Thruster1.CoordinateSystem = Local;
