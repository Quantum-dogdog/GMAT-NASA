GMAT EarthView.EnableStars = Off;
GMAT EarthView.EnableConstellations = Off;

Create OrbitView SolView;
GMAT SolView.SolverIterations = Current;
GMAT SolView.UpperLeft = [ 0.3847058823529412 0.09213759213759214 ];
GMAT SolView.Size = [ 0.548235294117647 0.8366093366093366 ];
GMAT SolView.RelativeZOrder = 164;
GMAT SolView.Maximized = false;
GMAT SolView.Add = {Tianwen2, Earth, Mars, Sun, kamoalewa, panstarrs};
GMAT SolView.CoordinateSystem = SolXyz;
GMAT SolView.DrawObject = [ true true true true true true ];
GMAT SolView.DataCollectFrequency = 1;
